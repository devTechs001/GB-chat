{
  "name": "wastapp-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cd gbchat/server && node index.js",
    "build": "cd gbchat/server && npm install && cd ../client && npm install",
    "install:client": "cd gbchat/client && npm install",
    "install:server": "cd gbchat/server && npm install",
    "deploy:gh-pages": "cd gbchat/client && npm install && npm run build && npx gh-pages -d dist"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "redis": "^4.6.13",
    "sharp": "^0.33.2",
