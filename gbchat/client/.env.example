# ============================================
# GBChat Client - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# API URLs - Required
# ============================================
# Your backend server URL (Render or other hosting)
# Format: https://your-app.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (for real-time features)
# Format: https://your-app.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true

# ============================================
# AI FEATURES (Optional)
# ============================================
# If using client-side AI features
# VITE_GOOGLE_CLOUD_API_KEY=your-api-key

# ============================================
# ANALYTICS (Optional)
# ============================================
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-dsn

# ============================================
# NOTES
# ============================================
# - For production, use your actual backend URL
# - Don't commit .env with real values to Git
# - Add .env to .gitignore
# - For Render static sites, set these in environment variables
# - Local development can use localhost URLs
