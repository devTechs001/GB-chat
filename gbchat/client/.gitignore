# Client .gitignore - React/Vite Frontend

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.lcov
.nyc_output

# Production builds
dist/
build/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# ENVIRONMENT VARIABLES & SECRETS - CRITICAL
# ============================================
# NEVER commit files with API keys or secrets

.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.*.local

# Backup env files
*.env.bak
*.env.backup
*.env.old

# ============================================
# CREDENTIALS & API KEYS
# ============================================
# Firebase config
firebase-config.js
firebase-*.json
serviceAccount.json

# Google
google-*.json
google-config.js

# Analytics
analytics-config.js
ga-tracking.json

# ============================================
# PRIVATE KEYS & CERTIFICATES
# ============================================
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ============================================
# CACHE & TEMP
# ============================================
.cache/
.parcel-cache/
.vite/
.eslintcache
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
