# ============================================
# GBChat Server - Complete Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5000

# ============================================
# DATABASE - MongoDB Atlas
# ============================================
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gbchat-enterprise
MONGODB_FALLBACK_URI=mongodb+srv://danielmk:password@cluster1.1frrfrb.mongodb.net/gbchat
# Local MongoDB Compass fallback
MONGODB_LOCAL_URI=mongodb://localhost:27017/gbchat

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate a random 32+ character string
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# ============================================
# FILE STORAGE - Cloudinary
# ============================================
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# CORS & CLIENT URLs
# ============================================
# Your frontend URL (Netlify or Render static site)
CLIENT_URL=https://gbchat.netlify.app
CORS_ORIGIN=https://gbchat.netlify.app

# ============================================
# EMAIL SERVICE - For Recovery & Notifications
# ============================================
# Gmail SMTP (recommended for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# Use App Password, not regular password
# Get from: Google Account → Security → App passwords
EMAIL_PASS=your-16-character-app-password

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# Global ceiling per user/IP
RATE_LIMIT_MAX=600
# Login / OTP
RATE_LIMIT_AUTH_MAX=20
# Password reset & OTP resend (per hour)
RATE_LIMIT_RESET_MAX=5
# Messages, stories, posts (per minute)
RATE_LIMIT_WRITE_MAX=120
# Avatar / media uploads (per hour)
RATE_LIMIT_UPLOAD_MAX=60
# Search (per minute)
RATE_LIMIT_SEARCH_MAX=90
# Call signalling (per minute)
RATE_LIMIT_CALL_MAX=30
# New accounts per network (per hour)
RATE_LIMIT_REGISTER_MAX=10
# Number of trusted proxy hops (1 behind nginx/Render)
TRUST_PROXY=1

# ============================================
# REDIS (required for multi-server mode)
# ============================================
# With Redis set, rate-limit counters, presence and the Socket.IO adapter are
# shared across every API replica, so you can run several containers/nodes.
# Without it the API still runs (single node, in-memory limits).
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# INTERNAL gRPC API (presence + notification fan-out)
# ============================================
GRPC_ENABLED=true
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_TARGET=127.0.0.1:50051
# Shared secret required from callers (leave empty to disable the check)
GRPC_AUTH_TOKEN=change_me_in_production
# Unique id for this node (used by presence + /api/system/info)
NODE_ID=gbchat-node-1
# WEB_CONCURRENCY / CLUSTER for npm run start:cluster
WEB_CONCURRENCY=1

# ============================================
# AI SERVICES (Optional - for chat assistant)
# ============================================
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# ============================================
# PAYMENT GATEWAYS (Optional)
# ============================================

# Stripe (International payments)
# Get from: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Razorpay (India - UPI payments)
# Get from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================
# WEB PUSH (VAPID) — background notifications
# ============================================
# Generate a pair with: npm run generate:vapid (in gbchat/server)
# Without these, /api/push returns enabled=false and the app degrades to
# in-app notifications only. Nothing else changes.
# VAPID_PUBLIC_KEY=BH...public_key...
# VAPID_PRIVATE_KEY=...private_key...
# VAPID_SUBJECT=mailto:notifications@gbchat.app
# WEB_PUSH_ENABLED=true
# WEB_PUSH_TTL_SECONDS=86400
# WEB_PUSH_MAX_SUBS_PER_USER=20

# ============================================
# OBSERVABILITY
# ============================================
# Log a [slow] line and count the request when it takes longer than this.
# SLOW_REQUEST_MS=1000
# How many browser crash reports to keep in memory (bounded ring).
# CLIENT_ERROR_BUFFER=100

# ============================================
# PUSH NOTIFICATIONS (Optional - Firebase)
# ============================================
# Get from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# ============================================
# SMS SERVICE (Optional - Twilio)
# ============================================
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# FILE UPLOAD LIMITS
# ============================================
# 2GB in bytes
MAX_FILE_SIZE=2147483648

# ============================================
# BACKUP SETTINGS (Optional)
# ============================================
# For email backups
BACKUP_EMAIL=backup@yourdomain.com
# For cloud storage backups
BACKUP_STORAGE_PATH=./backups

# ============================================
# LOGGING & MONITORING (Optional)
# ============================================
LOG_LEVEL=info
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# ============================================
# NOTES
# ============================================
# - Never commit this file with real values to Git
# - Add .env to .gitignore
# - Use different keys for development and production
# - Rotate keys regularly for security
# - Store production secrets in Render environment variables
# - Test all integrations after deployment
